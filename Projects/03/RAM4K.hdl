// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    DMux8Way(in = load, sel = address[9..11], a = w1, b = w2, c = w3, d = w4, e = w5, f = w6, g = w7, h = w8);

    RAM512(in = in, address[0..8] = address[0..8], load = w1, out = o1);
    RAM512(in = in, address[0..8] = address[0..8], load = w2, out = o2);
    RAM512(in = in, address[0..8] = address[0..8], load = w3, out = o3);
    RAM512(in = in, address[0..8] = address[0..8], load = w4, out = o4);
    RAM512(in = in, address[0..8] = address[0..8], load = w5, out = o5);
    RAM512(in = in, address[0..8] = address[0..8], load = w6, out = o6);
    RAM512(in = in, address[0..8] = address[0..8], load = w7, out = o7);
    RAM512(in = in, address[0..8] = address[0..8], load = w8, out = o8);
    
    Mux8Way16(a = o1, b = o2, c = o3, d = o4, e = o5, f = o6, g = o7, h = o8, sel = address[9..11], out = out);
}