// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Or(a = reset, b = load, out = trig1);
    Or(a = trig1, b = inc, out = trig2);
    Inc16(in = out1, out = in1);
    Mux8Way16(a = out1, b = in1, c = in, d = in, e = false, f = false, g = false, h = false, sel[2] = reset, sel[1] = load, sel[0] = inc, out = inf);
    Register(in = inf, load = trig2, out = out1, out = out);
}