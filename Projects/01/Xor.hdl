// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in = a, out = abar);
    Not(in = b, out = bbar);
    And(a = a, b = bbar, out = w1);
    And(a = b, b = abar, out = w2);
    Or(a = w1, b = w2, out = out);
}